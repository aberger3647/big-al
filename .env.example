# Self-hosted Supabase (shared stack with moongazing).
# These are read at BUILD time by Vite (import.meta.env.*), so they must be set
# in Dokploy's build environment for the deployed site, and in a local .env.local
# for `npm run dev`.

# Base URL of the Supabase stack. The contact form POSTs to
# `${VITE_SUPABASE_URL}/functions/v1/submit-inquiry`.
VITE_SUPABASE_URL=https://supabase.csbod.com

# Public anon key for the same stack (safe to expose in the browser). Optional
# for the contact form, but recommended so the request also passes any
# API-gateway apikey check.
VITE_SUPABASE_ANON_KEY=
